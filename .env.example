# For local dev only - Docker uses /app/data/flat-ledger.sqlite (set in compose)
DATABASE_URL=./data/flat-ledger.sqlite

AUTH_SECRET=change-this-long-random-secret
AUTH_URL=http://localhost:3000
DEV_SERVER_ALLOWED_HOSTS=
# Additional MCP server URLs, comma-separated, e.g. https://ledger.example.com,http://192.168.1.10:3000
MCP_SERVER_URLS=

ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
